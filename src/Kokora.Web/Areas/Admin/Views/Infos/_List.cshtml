@model ArticlesPageVm
@{
    var now = DateTimeOffset.UtcNow;
}
@if (Model.Items.Count == 0 && Model.Page == 1)
{
    <div class="empty border-t border-line">
        <strong>@(Model.Search is null ? "Aucune info" : "Aucun résultat")</strong>
        @(Model.Search is null ? "Rédigez un communiqué, un résumé de match ou une décision de la commission." : "Essayez un autre mot du titre.")
    </div>
}
else
{
    <ul class="border-t border-line">
        <partial name="_Rows" model="Model" />
    </ul>
}
