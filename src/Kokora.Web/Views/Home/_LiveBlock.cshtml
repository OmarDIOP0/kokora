@model HomeVm
@if (Model.Live.Count > 0)
{
    <section class="section" aria-live="polite">
        <header class="section-head">
            <span class="live-dot"></span>
            <span class="text-live">En direct</span>
            <span class="sub">@Model.Live.Count match@(Model.Live.Count > 1 ? "s" : "")</span>
        </header>
        @foreach (var m in Model.Live)
        {
            <div class="border-b border-line last:border-b-0">
                <div class="flex items-center gap-1.5 px-4 pt-2 text-[12px] text-ink-3" style="--comp:@m.CompetitionColor">
                    <span class="comp-swatch !h-2 !w-2"></span>@m.Competition · @m.Stage
                </div>
                <div class="[&>.match]:border-0"><partial name="Components/_MatchRow" model="m" view-data='new ViewDataDictionary(ViewData) { ["Wide"] = true }' /></div>
            </div>
        }
    </section>
}
