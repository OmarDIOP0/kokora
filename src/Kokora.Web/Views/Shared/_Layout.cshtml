@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var title = ViewData["Title"] as string;
    var fullTitle = string.IsNullOrEmpty(title) ? "Kokora — Navétane de Nguékokh" : $"{title} · Kokora";
    var description = ViewData["Description"] as string ?? "Résultats, classements, buteurs et matchs en direct du navétane de Nguékokh.";
    var csrf = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>@fullTitle</title>
    <meta name="description" content="@description">
    <meta name="theme-color" content="#ffffff">
    <meta name="csrf-token" content="@csrf">
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml">
    <link rel="preload" href="/fonts/barlow-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/barlow-condensed-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin>
    <script>
        (function () {
            var d = document.documentElement, t = null;
            try {
                t = localStorage.getItem('k-theme');
                var p = localStorage.getItem('k-palette');
                if (p && p !== 'pelouse') d.dataset.palette = p;
                if (localStorage.getItem('k-saver') === '1') d.dataset.saver = '1';
            } catch (e) { }
            d.dataset.theme = (t === 'dark' || t === 'light') ? t
                : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        })();
    </script>
    <link rel="stylesheet" href="~/dist/app.css" asp-append-version="true">
    <script type="module" src="~/dist/core.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="has-bottomnav">
    <a href="#contenu" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-50 focus:rounded-md focus:bg-surface focus:px-3 focus:py-2">Aller au contenu</a>

    <partial name="_TopBar" />
    @await RenderSectionAsync("SubHeader", required: false)

    <div class="offline-banner notice !bg-surface-2" role="status">
        <icon name="wifi-off" />
        <span>Hors ligne : vous consultez les dernières données enregistrées.</span>
    </div>

    <main id="contenu" class="mx-auto w-full max-w-[1280px] md:px-4 md:py-4">
        @RenderBody()
    </main>

    <partial name="_BottomNav" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
