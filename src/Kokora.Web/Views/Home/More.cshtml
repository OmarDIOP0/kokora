@{
    ViewData["Title"] = "Plus";
    var isStaff = User.IsInRole(Kokora.Application.Abstractions.Roles.SuperAdmin) || User.IsInRole(Kokora.Application.Abstractions.Roles.Admin)
                  || User.IsInRole(Kokora.Application.Abstractions.Roles.Editor);
}
<div class="mx-auto max-w-[640px] md:pt-2">
    <section class="section">
        <a href="/equipes" class="row"><icon name="shield" class="text-ink-2" /><span class="flex-1">Équipes</span><icon name="chevron-right" class="text-ink-3" /></a>
        <a href="/pronostics" class="row"><icon name="target" class="text-ink-2" /><span class="flex-1">Pronostics et classement des supporters</span><icon name="chevron-right" class="text-ink-3" /></a>
        <a href="/recherche" class="row"><icon name="search" class="text-ink-2" /><span class="flex-1">Rechercher une équipe ou un joueur</span><icon name="chevron-right" class="text-ink-3" /></a>
    </section>

    <section class="section" x-data>
        <header class="section-head"><span>Affichage</span></header>
        <label class="row cursor-pointer">
            <icon name="moon" class="text-ink-2" /><span class="flex-1">Mode sombre</span>
            <input type="checkbox" class="h-5 w-5 accent-[var(--brand)]" :checked="$store.theme.isDark" @@change="$store.theme.toggle()">
        </label>
        <label class="row cursor-pointer">
            <icon name="image" class="text-ink-2" />
            <span class="flex-1">Économie de données<span class="block text-[13px] text-ink-3">Masque les photos (utile en 3G).</span></span>
            <input type="checkbox" class="h-5 w-5 accent-[var(--brand)]" :checked="$store.theme.saver" @@change="$store.theme.toggleSaver()">
        </label>
    </section>

    <!-- Installer l'application -->
    <section class="section" x-data x-show="!$store.pwa.installed && ($store.pwa.canInstall || $store.pwa.iosHint)" x-cloak>
        <header class="section-head"><span>Application</span></header>
        <div class="flex items-center gap-3 px-4 py-3">
            <img src="/icons/icon-192.png" alt="" width="44" height="44" class="h-11 w-11 rounded-lg">
            <p class="min-w-0 flex-1 text-[14px] text-ink-2">
                <span class="block font-semibold text-ink">Installer Kokora</span>
                <span x-show="$store.pwa.canInstall">Sur l'écran d'accueil, léger, et consultable sans réseau.</span>
                <span x-show="$store.pwa.iosHint && !$store.pwa.canInstall">Touchez Partager puis « Sur l'écran d'accueil ».</span>
            </p>
            <button type="button" class="btn btn-primary btn-sm" x-show="$store.pwa.canInstall" @@click="$store.pwa.install()">Installer</button>
        </div>
    </section>

    <partial name="_PushSettings" />

    <section class="section">
        <header class="section-head"><span>Compte</span></header>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a href="/compte" class="row"><icon name="circle-user" class="text-ink-2" /><span class="flex-1 truncate">Mon compte</span><icon name="chevron-right" class="text-ink-3" /></a>
            @if (isStaff)
            {
                <a href="/admin" class="row"><icon name="layout-dashboard" class="text-ink-2" /><span class="flex-1">Administration</span><icon name="chevron-right" class="text-ink-3" /></a>
            }
            <form method="post" action="/compte/deconnexion">
                <button class="row w-full text-left text-loss"><icon name="log-out" /><span>Se déconnecter</span></button>
            </form>
        }
        else
        {
            <a href="/compte/connexion" class="row"><icon name="log-in" class="text-ink-2" /><span class="flex-1">Se connecter</span><icon name="chevron-right" class="text-ink-3" /></a>
            <a href="/compte/inscription" class="row"><icon name="user-plus" class="text-ink-2" /><span class="flex-1">Créer un compte <span class="block text-[13px] text-ink-3">pronostics, homme du match, commentaires</span></span><icon name="chevron-right" class="text-ink-3" /></a>
        }
    </section>

    <p class="px-4 py-6 text-center text-[12.5px] text-ink-3">Kokora · navétane de Nguékokh (ODCAV de Mbour)</p>
</div>
