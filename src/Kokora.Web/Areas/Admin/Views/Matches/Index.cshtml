@model MatchesPageVm
@{
    ViewData["Title"] = "Calendrier";
}

<div class="page-head">
    <div>
        <p class="label">Saison</p>
        <h1>Calendrier</h1>
    </div>
    <div class="flex flex-wrap gap-2">
        <a href="/admin/resultats" class="btn btn-secondary btn-sm"><icon name="list-checks" />Saisie rapide des résultats</a>
        <a href="/admin/matchs/nouveau" class="btn btn-primary btn-sm"><icon name="calendar-plus" />Nouveau match</a>
    </div>
</div>

<section class="section">
    <form class="grid gap-2 p-3 sm:grid-cols-[1fr_1fr_170px_auto] sm:items-center" hx-get="/admin/matchs" hx-target="#match-list"
          hx-trigger="change" hx-push-url="true">
        <select name="competition" class="input" aria-label="Compétition">
            <option value="">Toutes les compétitions</option>
            @foreach (var c in Model.Competitions)
            {
                <option value="@c.Value" selected="@(c.Value == Model.CompetitionId?.ToString())">@c.Text</option>
            }
        </select>
        <select name="equipe" class="input" aria-label="Équipe" data-tom>
            <option value="">Toutes les équipes</option>
            @foreach (var c in Model.Clubs)
            {
                <option value="@c.Value" selected="@(c.Value == Model.ClubId?.ToString())">@c.Text</option>
            }
        </select>
        <input name="jour" class="input" data-date placeholder="Tous les jours" value="@Model.Day?.ToString("yyyy-MM-dd")" aria-label="Jour">
        <label class="check whitespace-nowrap px-1"><input type="checkbox" name="sansResultat" value="true" checked="@Model.Missing"><span>Résultat manquant</span></label>
    </form>
    <div id="match-list">
        <partial name="_List" model="Model" />
    </div>
</section>
