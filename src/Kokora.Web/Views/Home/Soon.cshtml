@{
    var title = ViewData["Title"] as string ?? "Bientôt";
}
<section class="section mx-auto max-w-[640px] md:mt-6">
    <div class="empty">
        <strong>@title : bientôt disponible</strong>
        Cette section arrive dans une prochaine mise à jour. En attendant, retrouvez les matchs et les classements.
        <div class="mt-5 flex flex-wrap justify-center gap-2">
            <a href="/" class="btn btn-secondary btn-sm">Matchs</a>
            <a href="/classements" class="btn btn-secondary btn-sm">Classements</a>
        </div>
    </div>
</section>
