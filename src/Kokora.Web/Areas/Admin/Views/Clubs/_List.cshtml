@model List<Kokora.Domain.Clubs.Club>
@if (Model.Count == 0)
{
    <div class="empty border-t border-line">
        <strong>Aucune équipe</strong>
        Ajoutez les ASC de la zone, ou créez des données de démonstration pour tester.
    </div>
}
else
{
    <ul class="border-t border-line">
        @foreach (var c in Model)
        {
            <li>
                <a href="/admin/equipes/@c.Id/modifier" class="row">
                    <crest team="new TeamVm(c.Id, c.Name, c.ShortName, c.Slug, c.PrimaryColor, c.SecondaryColor, c.LogoPath)" size="lg" />
                    <div class="min-w-0 flex-1">
                        <div class="truncate font-semibold">@c.Name</div>
                        <div class="truncate text-[13px] text-ink-3">
                            @(c.Neighborhood ?? "Quartier non renseigné")@(c.Zone is null ? "" : $" · Zone {c.Zone}")
                        </div>
                    </div>
                    @if (!c.IsActive) { <span class="badge">Inactive</span> }
                    @if (c.IsDemo) { <span class="badge warn">Démo</span> }
                    <icon name="chevron-right" class="text-ink-3" />
                </a>
            </li>
        }
    </ul>
}
