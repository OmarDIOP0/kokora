@{
    ViewData["Title"] = "Erreur";
}
<section class="section">
    <div class="px-4 py-10 text-center">
        <p class="font-display text-2xl font-bold">Une erreur est survenue</p>
        <p class="mt-1 text-ink-2">Réessayez dans un instant. Si le problème persiste, contactez l'organisation.</p>
        @if (ViewData["RequestId"] is string id)
        {
            <p class="mt-4 text-xs text-ink-3">Référence : <code>@id</code></p>
        }
        <a href="/" class="btn btn-secondary mt-6">Retour à l'accueil</a>
    </div>
</section>
