@model MatchPageVm
@{
    var d = Model.Detail;
    var m = d.Match;
    var homeName = m.Home?.Name ?? m.HomePlaceholder;
    var awayName = m.Away?.Name ?? m.AwayPlaceholder;
    ViewData["Title"] = m.ShowScore ? $"{homeName} {m.HomeScore}-{m.AwayScore} {awayName}" : $"{homeName} - {awayName}";
    ViewData["Description"] = Model.ShareText;
    var outcome = m.Outcome;
    var hasLineups = d.HomeLineup.Count + d.AwayLineup.Count > 0;
    var whatsapp = "https://wa.me/?text=" + Uri.EscapeDataString($"{Model.ShareText}\n{Model.ShareUrl}");
}
@section Head {
    <meta property="og:type" content="website">
    <meta property="og:title" content="@ViewData["Title"]">
    <meta property="og:description" content="@d.Competition.Name · @d.PhaseName@(m.KickoffAt is { } ok ? " · " + KokoraTime.Long(ok) : "")">
    <meta property="og:url" content="@Model.ShareUrl">
    <meta property="og:site_name" content="Kokora">
    <meta name="twitter:card" content="summary">
    <link rel="canonical" href="@Model.ShareUrl">
    @if (Model.Photos.Count > 0)
    {
        <meta property="og:image" content="@($"{Context.Request.Scheme}://{Context.Request.Host}{Model.Photos[0].Url}")">
        <link rel="stylesheet" href="~/dist/gallery.css" asp-append-version="true">
        <script type="module" src="~/dist/gallery.js" asp-append-version="true"></script>
    }
}

<div class="mx-auto max-w-[760px]" data-live-page="@m.Id" data-watch="@(m.Watch ? "" : null)">
    <section class="section">
        <!-- En-tête du match (rafraîchi en direct) -->
        <partial name="_MatchHeader" model="Model.Detail" />

        <!-- Onglets -->
        <div x-data="{ tab: 'resume' }">
            <div class="tabs !border-t !border-line" role="tablist" aria-label="Détails du match">
                <button class="tab" role="tab" :aria-selected="tab === 'resume'" @@click="tab = 'resume'" aria-selected="true">Résumé</button>
                @if (hasLineups)
                {
                    <button class="tab" role="tab" :aria-selected="tab === 'compos'" @@click="tab = 'compos'" aria-selected="false">Compositions</button>
                }
                <button class="tab" role="tab" :aria-selected="tab === 'stats'" @@click="tab = 'stats'" aria-selected="false">Stats</button>
                <button class="tab" role="tab" :aria-selected="tab === 'h2h'" @@click="tab = 'h2h'" aria-selected="false">Confrontations</button>
                @if (Model.Photos.Count > 0)
                {
                    <button class="tab" role="tab" :aria-selected="tab === 'photos'" @@click="tab = 'photos'" aria-selected="false">Photos <span class="num text-ink-3">@Model.Photos.Count</span></button>
                }
            </div>

            <!-- Résumé : chronologie -->
            <div role="tabpanel" x-show="tab === 'resume'">
                <partial name="_Timeline" model="Model.Detail" />
            </div>

            <!-- Compositions -->
            @if (hasLineups)
            {
                <div role="tabpanel" x-show="tab === 'compos'" x-cloak class="grid grid-cols-2">
                    @foreach (var (team, lineup) in new[] { (m.Home, d.HomeLineup), (m.Away, d.AwayLineup) })
                    {
                        <div class="border-r border-line last:border-r-0">
                            <div class="label border-b border-line px-4 py-2">@team?.ShortName</div>
                            @foreach (var p in lineup)
                            {
                                <div class="row !min-h-10 !gap-2 text-[13.5px] @(p.IsStarter ? "" : "text-ink-2")">
                                    <span class="num w-6 text-right text-ink-3">@p.Number</span>
                                    <span class="truncate">@p.Name@(p.IsCaptain ? " (c)" : "")</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            <!-- Stats -->
            <div role="tabpanel" x-show="tab === 'stats'" x-cloak>
                @{
                    var stats = new List<(string Label, int H, int A)>();
                    if (m.ShowScore) stats.Add(("Buts", m.HomeScore ?? 0, m.AwayScore ?? 0));
                    stats.Add(("Cartons jaunes", d.HomeYellow, d.AwayYellow));
                    stats.Add(("Cartons rouges", d.HomeRed, d.AwayRed));
                }
                @foreach (var (label, h, a) in stats)
                {
                    var total = Math.Max(1, h + a);
                    <div class="border-b border-line px-4 py-3 last:border-b-0">
                        <div class="flex items-center justify-between text-[14px]">
                            <span class="score text-lg">@h</span><span class="text-ink-2">@label</span><span class="score text-lg">@a</span>
                        </div>
                        <div class="mt-1.5 flex h-1.5 gap-1 overflow-hidden rounded-full" aria-hidden="true">
                            <span class="rounded-full bg-brand" style="width:@(h * 100 / total)%"></span>
                            <span class="flex-1 rounded-full bg-line-strong"></span>
                        </div>
                    </div>
                }
                <p class="px-4 py-3 text-[12.5px] text-ink-3">Les statistiques détaillées (tirs, possession) ne sont pas relevées au navétane.</p>
            </div>

            <!-- Confrontations -->
            <div role="tabpanel" x-show="tab === 'h2h'" x-cloak>
                @if (d.HeadToHead.Count == 0)
                {
                    <div class="empty !py-8">Première confrontation enregistrée entre ces deux équipes.</div>
                }
                else
                {
                    var (hw, dr, aw) = d.HeadToHeadSummary;
                    <div class="grid grid-cols-3 border-b border-line text-center">
                        <div class="stat"><div class="v">@hw</div><div class="label mt-1">@m.Home?.ShortName</div></div>
                        <div class="stat border-x border-line"><div class="v">@dr</div><div class="label mt-1">Nuls</div></div>
                        <div class="stat"><div class="v">@aw</div><div class="label mt-1">@m.Away?.ShortName</div></div>
                    </div>
                    @foreach (var h in d.HeadToHead)
                    {
                        <div class="border-b border-line last:border-b-0">
                            <div class="px-4 pt-2 text-[12px] text-ink-3">@(h.KickoffAt is { } hk ? KokoraTime.ToLocal(hk).ToString("d MMM yyyy", KokoraTime.Fr) : "") · @h.Competition</div>
                            <div class="[&>.match]:border-0"><partial name="Components/_MatchRow" model="h" /></div>
                        </div>
                    }
                }
            </div>

            @if (Model.Photos.Count > 0)
            {
                <div role="tabpanel" x-show="tab === 'photos'" x-cloak>
                    <partial name="Components/_PhotoGrid" model="Model.Photos" />
                </div>
            }
        </div>

        <!-- Partage -->
        <div class="flex gap-2 border-t border-line p-3" x-data="{ canShare: !!navigator.share }">
            <a href="@whatsapp" target="_blank" rel="noopener" class="btn btn-secondary btn-sm flex-1"><icon name="share-2" />WhatsApp</a>
            <button type="button" class="btn btn-secondary btn-sm flex-1" x-show="canShare" x-cloak
                    @@click="navigator.share({ title: document.title, text: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.ShareText))', url: '@Model.ShareUrl' }).catch(() => {})">
                <icon name="share-2" />Partager
            </button>
        </div>
    </section>

    @if (Model.Vote is not null) { <partial name="_Vote" model="new VotePartVm(m.Id, Model.Vote)" /> }
    @if (Model.Prediction is not null) { <partial name="_Prediction" model="new PredictionPartVm(m.Id, Model.Prediction, m)" /> }

    @if (Model.News.Count > 0)
    {
        <section class="section">
            <header class="section-head"><span>Infos sur ce match</span></header>
            @foreach (var n in Model.News) { <partial name="Components/_ArticleRow" model="n" /> }
        </section>
    }
</div>
