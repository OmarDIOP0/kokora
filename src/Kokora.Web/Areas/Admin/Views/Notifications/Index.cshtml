@model NotificationsPageVm
@{
    ViewData["Title"] = "Notifications";
    var a = Model.Audience;
}
<div class="page-head">
    <div>
        <p class="label">Contenu</p>
        <h1>Notifications</h1>
        <p class="mt-1 max-w-[62ch] text-[14px] text-ink-2">
            Buts, coups d'envoi et résultats partent automatiquement depuis le mode terrain vers les supporters des deux équipes ;
            les infos marquées « importantes » partent à leur publication. Ici : un message ponctuel (report de match, annonce urgente).
        </p>
    </div>
</div>

<div class="grid gap-3 lg:grid-cols-[minmax(0,1fr)_320px] lg:items-start">
    <section class="section">
        <header class="section-head"><span>Nouveau message</span></header>
        @if (!Model.Enabled)
        {
            <div class="notice m-4" role="alert"><icon name="triangle-alert" />Notifications non configurées sur ce serveur (clés VAPID absentes, voir README).</div>
        }
        <form method="post" action="/admin/notifications" x-data="{ title: '', body: '' }" data-confirm="Envoyer cette notification maintenant ?">
            <div class="form-grid">
                <div class="field">
                    <label for="n-title">Titre</label>
                    <input id="n-title" name="title" maxlength="80" required class="input" x-model="title" placeholder="Ex. Match reporté">
                    <span class="hint" x-text="`${title.length}/80`"></span>
                </div>
                <div class="field">
                    <label for="n-body">Message</label>
                    <textarea id="n-body" name="body" maxlength="200" required rows="3" class="input textarea" x-model="body"
                              placeholder="Ex. ASC Démo 1 - ASC Démo 5 est reporté à dimanche 17h."></textarea>
                    <span class="hint" x-text="`${body.length}/200`"></span>
                </div>
                <div class="field">
                    <label for="n-url">Lien ouvert au toucher (facultatif)</label>
                    <input id="n-url" name="url" class="input" placeholder="/infos/… ou /matchs/…" pattern="/.*">
                    <span class="hint">Adresse d'une page du site, commençant par « / ».</span>
                </div>
                <div class="field">
                    <label for="n-club">Destinataires</label>
                    <select id="n-club" name="clubId" class="input" data-tom>
                        <option value="">Tous les abonnés (@a.All)</option>
                        @foreach (var c in Model.Clubs)
                        {
                            <option value="@c.Value">Supporters de @c.Text (@(a.ByClub.FirstOrDefault(x => x.ClubId.ToString() == c.Value).Count))</option>
                        }
                    </select>
                </div>
                <!-- Aperçu -->
                <div class="flex gap-3 rounded-md border border-line bg-surface-2 p-3" aria-hidden="true">
                    <img src="/icons/icon-192.png" alt="" width="36" height="36" class="h-9 w-9 rounded-md">
                    <div class="min-w-0">
                        <div class="truncate text-[14px] font-semibold" x-text="title || 'Titre de la notification'"></div>
                        <div class="line-clamp-2 text-[13px] text-ink-2" x-text="body || 'Message'"></div>
                    </div>
                </div>
            </div>
            <div class="form-actions"><button class="btn btn-primary" disabled="@(!Model.Enabled)"><icon name="send" />Envoyer</button></div>
        </form>
    </section>

    <section class="section">
        <header class="section-head"><span>Abonnés</span><span class="sub">@a.All appareil@(a.All > 1 ? "s" : "")</span></header>
        <div class="row"><span class="flex-1">Infos importantes</span><span class="num font-semibold">@a.News</span></div>
        @foreach (var (_, club, count) in a.ByClub.Take(20))
        {
            <div class="row"><span class="min-w-0 flex-1 truncate">@club</span><span class="num font-semibold">@count</span></div>
        }
        @if (a.All == 0) { <div class="empty !py-6">Aucun abonné pour l'instant.</div> }
    </section>
</div>
