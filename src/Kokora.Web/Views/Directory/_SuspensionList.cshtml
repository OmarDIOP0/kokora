@model IReadOnlyList<SuspensionRowVm>
@if (Model.Count == 0)
{
    <div class="empty !py-6">Aucun joueur suspendu.</div>
}
@foreach (var s in Model)
{
    <a href="@s.Player.Url" class="row !items-start">
        <crest team="s.Team" />
        <span class="min-w-0 flex-1">
            <span class="block truncate font-semibold">@s.Player.Name <span class="font-normal text-ink-3">· @s.Team.ShortName</span></span>
            <span class="block text-[12.5px] text-ink-2">
                @if (s.Reason is Kokora.Domain.Rules.SuspensionReason.DirectRed or Kokora.Domain.Rules.SuspensionReason.SecondYellow)
                {
                    <span class="card-icon red mr-1 inline-block !h-2.5 !w-2 align-[-1px]"></span>
                }
                else if (s.Reason is Kokora.Domain.Rules.SuspensionReason.YellowAccumulation)
                {
                    <span class="card-icon yellow mr-1 inline-block !h-2.5 !w-2 align-[-1px]"></span>
                }
                @s.ReasonLabel · @s.Competition
            </span>
        </span>
        <span class="text-right">
            <span class="score block text-[20px] @(s.Remaining > 0 ? "text-loss" : "text-ink-3")">@s.Remaining</span>
            <span class="block text-[11px] text-ink-3">match@(s.Remaining > 1 ? "s" : "") restant@(s.Remaining > 1 ? "s" : "")</span>
        </span>
    </a>
}
