@model ArticlePageVm
@{
    var a = Model.Article;
    var c = a.Card;
    ViewData["Title"] = c.Title;
    ViewData["Description"] = c.Summary ?? "Info du navétane de Nguékokh.";
    var whatsapp = "https://wa.me/?text=" + Uri.EscapeDataString($"{c.Title}\n{Model.ShareUrl}");
    var compact = new ViewDataDictionary(ViewData) { ["Compact"] = true };
    var imageUrl = c.CoverUrl is null ? null : $"{Context.Request.Scheme}://{Context.Request.Host}{c.CoverUrl}";
}
@section Head {
    <meta property="og:type" content="article">
    <meta property="og:title" content="@c.Title">
    <meta property="og:description" content="@ViewData["Description"]">
    <meta property="og:url" content="@Model.ShareUrl">
    <meta property="og:site_name" content="Kokora">
    @if (imageUrl is not null)
    {
        <meta property="og:image" content="@imageUrl">
        <meta name="twitter:card" content="summary_large_image">
    }
    @if (a.IsLive) { <meta property="article:published_time" content="@c.PublishedAt.ToString("O")"> }
    else { <meta name="robots" content="noindex"> }
    <link rel="canonical" href="@Model.ShareUrl">
    @if (a.Photos.Count > 0) { <link rel="stylesheet" href="~/dist/gallery.css" asp-append-version="true">
        <script type="module" src="~/dist/gallery.js" asp-append-version="true"></script> }
}

<article class="mx-auto max-w-[720px]">
    @if (!a.IsLive)
    {
        <div class="notice mb-3 !bg-[color-mix(in_srgb,var(--warn)_14%,transparent)]" role="status">
            <icon name="eye" />
            <span>
                Aperçu réservé à la rédaction :
                @(a.Status switch
                {
                    ArticleStatus.Scheduled => $"publication programmée le {KokoraTime.Long(c.PublishedAt).ToLower(KokoraTime.Fr)}.",
                    ArticleStatus.Archived => "info archivée, retirée du site.",
                    _ => "brouillon non publié."
                })
            </span>
        </div>
    }

    <section class="section">
        <header class="px-4 pb-4 pt-4 md:px-6 md:pt-6">
            <div class="news-meta">
                <a href="/infos" class="hover:text-ink">Infos</a>
                @if (c.Category is not null)
                {
                    <span aria-hidden="true">/</span><a href="/infos?categorie=@c.CategorySlug" class="text-brand hover:underline">@c.Category</a>
                }
                @if (c.IsImportant) { <span aria-hidden="true">·</span><span class="text-loss">Important</span> }
            </div>
            <h1 class="mt-2 text-[30px] leading-[1.05] md:text-[40px]">@c.Title</h1>
            @if (a.Lead is not null) { <p class="lead mt-3">@a.Lead</p> }
            <p class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-[13px] text-ink-3">
                @if (a.AuthorName is not null) { <span class="font-semibold text-ink-2">@a.AuthorName</span><span aria-hidden="true">·</span> }
                <time datetime="@c.PublishedAt.ToString("O")">@KokoraTime.Long(c.PublishedAt)</time>
                <span aria-hidden="true">·</span><span>@c.ReadMinutes min de lecture</span>
                @if (a.UpdatedAt is { } u) { <span aria-hidden="true">·</span><span>mis à jour le @KokoraTime.ToLocal(u).ToString("d MMM à HH\\hmm", KokoraTime.Fr)</span> }
            </p>
        </header>

        @if (c.CoverUrl is not null)
        {
            <img src="@c.CoverUrl" alt="" width="1600" height="900" class="aspect-video w-full border-y border-line object-cover" data-photo fetchpriority="high">
        }

        <div class="prose-k px-4 py-5 md:px-6">@Html.Raw(a.BodyHtml)</div>

        @if (a.Photos.Count > 0)
        {
            <div class="border-t border-line">
                <div class="section-head"><span>Photos</span><span class="sub">@a.Photos.Count</span></div>
                <partial name="Components/_PhotoGrid" model="a.Photos" />
            </div>
        }

        @if (a.Tags.Count > 0)
        {
            <div class="flex flex-wrap gap-1.5 border-t border-line px-4 py-3 md:px-6">
                @foreach (var t in a.Tags) { <a href="/infos?tag=@t.Slug" class="chip">#@t.Name</a> }
            </div>
        }

        <div class="flex gap-2 border-t border-line p-3" x-data="{ canShare: !!navigator.share, copied: false }">
            <a href="@whatsapp" target="_blank" rel="noopener" class="btn btn-secondary btn-sm flex-1"><icon name="message-circle" />WhatsApp</a>
            <button type="button" class="btn btn-secondary btn-sm flex-1" x-show="canShare" x-cloak
                    @@click="navigator.share({ title: document.title, url: '@Model.ShareUrl' }).catch(() => {})">
                <icon name="share-2" />Partager
            </button>
            <button type="button" class="btn btn-secondary btn-sm flex-1" x-show="!canShare"
                    @@click="navigator.clipboard?.writeText('@Model.ShareUrl').then(() => { copied = true; setTimeout(() => copied = false, 2000) })">
                <icon name="link" /><span x-text="copied ? 'Lien copié' : 'Copier le lien'">Copier le lien</span>
            </button>
        </div>
    </section>

    @if (a.Teams.Count > 0)
    {
        <section class="section">
            <header class="section-head"><span>Équipes citées</span></header>
            <div class="grid sm:grid-cols-2">
                @foreach (var t in a.Teams)
                {
                    <a href="@t.Url" class="row sm:odd:border-r sm:odd:border-line"><crest team="t" /><span class="min-w-0 flex-1 truncate font-medium">@t.Name</span><icon name="chevron-right" class="text-ink-3" /></a>
                }
            </div>
        </section>
    }

    @if (a.Matches.Count > 0)
    {
        <section class="section">
            <header class="section-head"><span>@(a.Matches.Count > 1 ? "Matchs" : "Le match")</span></header>
            @foreach (var m in a.Matches)
            {
                <div class="border-b border-line last:border-b-0">
                    <div class="px-4 pt-2 text-[12px] text-ink-3">@(m.KickoffAt is { } k ? KokoraTime.Day(DateOnly.FromDateTime(KokoraTime.ToLocal(k).DateTime)) + " · " : "")@m.Competition · @m.Stage</div>
                    <div class="[&>.match]:border-0"><partial name="Components/_MatchRow" model="m" /></div>
                </div>
            }
        </section>
    }

    @if (a.Related.Count > 0)
    {
        <section class="section">
            <header class="section-head"><span>À lire aussi</span></header>
            @foreach (var r in a.Related) { <partial name="Components/_ArticleRow" model="r" view-data="compact" /> }
        </section>
    }
</article>
