@model HomeVm
@{
    ViewData["Title"] = null;
    var ctx = Model.Ctx;
    var wide = new ViewDataDictionary(ViewData) { ["Wide"] = true };
    var compSlug = ctx.Selected?.Slug;
}
@section SubHeader {
    <div class="border-b border-line bg-surface lg:hidden">
        <partial name="Components/_CompetitionBar" view-data='new ViewDataDictionary(ViewData) { ["Ctx"] = ctx, ["Base"] = "/" }' />
    </div>
}

@if (ctx.Season is null)
{
    <section class="section">
        <div class="empty">
            <strong>La saison n'a pas encore commencé</strong>
            Le calendrier du navétane sera publié ici dès qu'il sera connu.
        </div>
    </section>
    return;
}

<div class="grid gap-4 lg:grid-cols-[220px_minmax(0,1fr)_300px] xl:grid-cols-[240px_minmax(0,1fr)_340px]">

    <!-- Colonne gauche : compétitions, équipes suivies -->
    <aside class="hidden lg:block">
        <div class="sticky top-[72px] space-y-3">
            <section class="section">
                <header class="section-head"><span class="label !text-ink-2">Compétitions</span></header>
                <a href="@Model.Url(comp: "toutes")" class="row !min-h-11 text-[14px] font-medium @(ctx.Selected is null ? "text-brand" : "")">
                    <icon name="layers" class="text-ink-3" />Toutes
                </a>
                @foreach (var c in ctx.Competitions)
                {
                    <a href="@Model.Url(comp: c.Slug)" class="row !min-h-11 text-[14px] font-medium @(ctx.Selected?.Id == c.Id ? "bg-brand-soft" : "")" style="--comp:@c.Color">
                        <span class="comp-swatch"></span><span class="truncate">@c.Name</span>
                    </a>
                }
            </section>
            <section class="section">
                <header class="section-head"><span class="label !text-ink-2">Mes équipes</span></header>
                @foreach (var t in Model.FavoriteTeams)
                {
                    <a href="@t.Url" class="row !min-h-11 text-[14px]"><crest team="t" /><span class="truncate">@t.Name</span></a>
                }
                @if (Model.FavoriteTeams.Count == 0)
                {
                    <p class="px-4 py-3 text-[13px] text-ink-3">Suivez vos équipes depuis leur fiche : leurs matchs apparaîtront en premier.</p>
                }
            </section>
        </div>
    </aside>

    <!-- Colonne centrale : matchs -->
    <div class="min-w-0">
        @if (Model.Featured is { } fm)
        {
            <a href="@fm.Url" class="mb-3 flex items-center gap-3 border-b border-line bg-surface px-4 py-3 lg:hidden md:rounded-md md:border">
                <icon name="clock" class="text-brand" />
                <div class="min-w-0 flex-1">
                    <div class="label">@fm.Competition · @fm.Stage</div>
                    <div class="truncate font-semibold">@(fm.Home?.ShortName ?? fm.HomePlaceholder) – @(fm.Away?.ShortName ?? fm.AwayPlaceholder)</div>
                </div>
                @if (fm.KickoffAt is { } fk)
                {
                    <span class="score text-[18px]" data-countdown="@fk.ToString("O")">@KokoraTime.Hour(fk)</span>
                }
            </a>
        }

        <div class="md:mb-3 md:overflow-clip md:rounded-md md:border md:border-line">
            <div class="flex items-center justify-between gap-2 bg-surface px-4 py-2.5 border-b border-line">
                <nav class="segmented" aria-label="Affichage des matchs">
                    <a href="@Model.Url(MatchesView.Day, KokoraTime.Today)" aria-current="@(Model.View == MatchesView.Day ? "page" : null)" class="@(Model.View == MatchesView.Day ? "is-active" : "")">Par jour</a>
                    <a href="@Model.Url(MatchesView.Upcoming)" aria-current="@(Model.View == MatchesView.Upcoming ? "page" : null)" class="@(Model.View == MatchesView.Upcoming ? "is-active" : "")">À venir</a>
                    <a href="@Model.Url(MatchesView.Results)" aria-current="@(Model.View == MatchesView.Results ? "page" : null)" class="@(Model.View == MatchesView.Results ? "is-active" : "")">Résultats</a>
                </nav>
                @if (ctx.Selected is { } sel)
                {
                    <span class="hidden items-center gap-1.5 text-[13px] text-ink-2 sm:flex" style="--comp:@sel.Color"><span class="comp-swatch !h-2.5 !w-2.5"></span>@sel.Name</span>
                }
            </div>
            @if (Model.View == MatchesView.Day)
            {
                <nav class="datestrip" aria-label="Jours">
                    @foreach (var d in Model.Strip)
                    {
                        var info = Model.Days.GetValueOrDefault(d);
                        var isToday = d == KokoraTime.Today;
                        var cls = (info?.HasLive ?? false) ? "has-live" : info is null ? "is-empty" : "";
                        <a href="@Model.Url(MatchesView.Day, d)" class="@cls" aria-current="@(d == Model.Date ? "date" : null)"
                           aria-label="@KokoraTime.DayRelative(d)@(info is null ? ", aucun match" : $", {info.Matches} match{(info.Matches > 1 ? "s" : "")}")">
                            <span class="dow">@(isToday ? "Auj." : KokoraTime.ShortDayName(d))</span>
                            <span class="day">@d.Day</span>
                        </a>
                    }
                </nav>
            }
        </div>

        @* Bloc « En direct » : mis à jour instantanément par le temps réel (live.js), sinon toutes les 30 s. *@
        <div id="live-block" class="max-md:mt-2 empty:hidden" hx-get="@Model.Url()" hx-trigger="every 30s[!window.kLive], refresh" hx-swap="innerHTML">
            <partial name="_LiveBlock" model="Model" />
        </div>

        @if (Model.View == MatchesView.Day)
        {
            <h1 class="sr-only">Matchs du @KokoraTime.Day(Model.Date)</h1>
            <div class="max-md:mt-2">
                @if (Model.Groups.Count == 0)
                {
                    <section class="section">
                        <div class="empty">
                            <strong>Aucun match @(Model.Date == KokoraTime.Today ? "aujourd'hui" : "ce jour-là")</strong>
                            @if (Model.NearestDay is { } nd)
                            {
                                <a class="mt-3 inline-flex items-center gap-1 font-semibold text-brand" href="@Model.Url(MatchesView.Day, nd)">
                                    Voir les matchs du @KokoraTime.Day(nd).ToLower()<icon name="chevron-right" />
                                </a>
                            }
                        </div>
                    </section>
                }
                @foreach (var g in Model.Groups)
                {
                    <partial name="Components/_MatchGroup" model="g" view-data="wide" />
                }
            </div>
        }
        else if (Model.List is { } list)
        {
            <h1 class="sr-only">@(Model.View == MatchesView.Upcoming ? "Matchs à venir" : "Derniers résultats")</h1>
            <div class="max-md:mt-2">
                @if (list.Days.Count == 0)
                {
                    <section class="section"><div class="empty">
                        <strong>@(Model.View == MatchesView.Upcoming ? "Aucun match programmé" : "Aucun résultat pour l'instant")</strong>
                    </div></section>
                }
                <partial name="_MatchList" model="list" />
            </div>
        }
    </div>

    <!-- Colonne droite : prochain grand match, classement résumé -->
    <aside class="space-y-3">
        @if (Model.Featured is { } f)
        {
            <section class="section hidden lg:block">
                <header class="section-head"><span class="label !text-ink-2">Prochain grand match</span></header>
                <a href="@f.Url" class="block px-4 py-4 text-center hover:bg-surface-2">
                    <p class="label">@f.Competition · @f.Stage</p>
                    <div class="mt-3 grid grid-cols-[1fr_auto_1fr] items-center gap-2">
                        <div class="grid justify-items-center gap-1.5">
                            @if (f.Home is not null) { <crest team="f.Home" size="lg" /> } else { <span class="crest lg">?</span> }
                            <span class="text-[13px] font-semibold">@(f.Home?.ShortName ?? f.HomePlaceholder)</span>
                        </div>
                        <span class="font-display text-xl font-semibold text-ink-3">VS</span>
                        <div class="grid justify-items-center gap-1.5">
                            @if (f.Away is not null) { <crest team="f.Away" size="lg" /> } else { <span class="crest lg">?</span> }
                            <span class="text-[13px] font-semibold">@(f.Away?.ShortName ?? f.AwayPlaceholder)</span>
                        </div>
                    </div>
                    @if (f.IsLive)
                    {
                        <p class="mt-4 inline-flex items-center gap-1.5 font-semibold text-live"><span class="live-dot"></span>En direct</p>
                    }
                    else if (f.KickoffAt is { } k)
                    {
                        <p class="score mt-4 text-[26px]" data-countdown="@k.ToString("O")">@KokoraTime.Hour(k)</p>
                        <p class="mt-1 text-[13px] text-ink-2">@KokoraTime.Long(k)@(f.Stadium is null ? "" : $" · {f.Stadium}")</p>
                    }
                </a>
            </section>
        }

        @if (Model.MiniStandings is { } mini)
        {
            <section class="section">
                <header class="section-head">
                    <span class="truncate">@mini.Title</span>
                    <a href="@Model.MiniStandingsUrl" class="ml-auto whitespace-nowrap text-[13px] font-semibold text-brand">Complet</a>
                </header>
                <partial name="Components/_StandingsTable" model="mini" />
            </section>
        }

        @if (User.Identity?.IsAuthenticated != true)
        {
            <section class="section">
                <a href="/plus" class="notice !border-0 hover:underline"><icon name="bell" class="text-brand" /><span>Reçois les buts de tes équipes en direct : active les notifications.</span></a>
            </section>
        }
    </aside>
</div>
