# Copier ce fichier en .env (à la racine du projet) et remplacer les valeurs. Ne jamais le publier.
DOMAIN=kokora.example.sn
POSTGRES_PASSWORD=remplacer-par-un-long-mot-de-passe
# Premier super admin (créé au premier démarrage s'il n'en existe aucun ; ces lignes peuvent ensuite être retirées)
ADMIN_LOGIN=admin@example.sn
ADMIN_PASSWORD=remplacer-par-un-mot-de-passe-solide-1
CONTACT_EMAIL=contact@example.sn
# Sauvegardes (deploy/backup.sh)
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
# Copie hors du serveur (facultatif) : nom d'un « remote » rclone, ex. gdrive:kokora
RCLONE_REMOTE=
